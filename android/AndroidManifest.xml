<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.mainsailcnc.pendant" android:versionCode="3" android:versionName="0.3.0-preview">
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
